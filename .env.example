# Server-only origin. Development defaults to this address.
BACKEND_URL=http://localhost:8080
# Staging and production: set BACKEND_URL in the server deployment environment
# to the actual HTTPS backend origin. No path, query, credentials or trailing API prefix.
# Production has no implicit localhost fallback; missing configuration shows unavailable.
# Never put credentials into NEXT_PUBLIC_* variables.

# OIDC settings are read only by the Next.js server.
APP_URL=http://localhost:3000
OIDC_ISSUER=http://localhost:8081/realms/nitros-games
OIDC_CLIENT_ID=nitros-games-web
OIDC_SCOPES=openid profile email
# Only permits loopback HTTP issuers for local development/testing. Use false with HTTPS.
OIDC_ALLOW_HTTP=true
# Generate 32 random bytes as 64 hexadecimal characters. Never commit the real value.
AUTH_SECRET=
# Optional for a confidential client; the existing Keycloak client is public.
OIDC_CLIENT_SECRET=
# Private persistent filesystem directory, outside public/. Protect with OS permissions.
AUTH_SESSION_DIR=.data/auth
